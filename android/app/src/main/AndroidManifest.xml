<?xml version="1.0" encoding="utf-8"?>
<!-- The package attribute is required by the Gradle-free build in build.sh (aapt2 link);
     it must stay in sync with `namespace` in app/build.gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aether.titanmd"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- INTERNET: the portal is remote.
         FOREGROUND_SERVICE + DATA_SYNC: the watch service that notifies when a code is ready.
         POST_NOTIFICATIONS: that notification on Android 13+.
         Nothing else — no storage, contacts, camera, location or telephony. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links for the portal host. autoVerify requires the host to serve
                 /.well-known/assetlinks.json containing this build's signing certificate
                 (see README); without it, links simply open in the browser instead. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="titan-md-repo.vercel.app" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Polls the single request this app started, so a code that arrives while the app is
             backgrounded still reaches the user. Not exported. -->
        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
